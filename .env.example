# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
# All of these are deploy-time credentials only; none is used by the website at
# runtime, and none is bundled into the build.

# Netlify — https://app.netlify.com/user/applications#personal-access-tokens
# NOTE: a Netlify personal access token has FULL ACCOUNT access, not per-site.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Vercel — https://vercel.com/account/settings/tokens (shown once; set an expiry)
VERCEL_TOKEN=
# From `npx vercel link`, which writes .vercel/project.json
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Monid (optional, used only by tooling, not by the site)
MONID_KEY=
